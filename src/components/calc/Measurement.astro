---
interface Props { field: string; label: string; x: number; y: number; x1: number; y1: number; x2: number; y2: number; }
const { field,label,x,y,x1,y1,x2,y2 } = Astro.props;
const length = Math.hypot(x2-x1,y2-y1) || 1;
const dx = -(y2-y1)/length*4, dy = (x2-x1)/length*4;
---
<g class="measurement" data-measure={field}>
  <path d={`M${x1} ${y1}L${x2} ${y2}M${x1-dx} ${y1-dy}L${x1+dx} ${y1+dy}M${x2-dx} ${y2-dy}L${x2+dx} ${y2+dy}`} />
  <text x={x} y={y} text-anchor="middle">{label}</text>
</g>
