const drawing = drawings[slug.replace(/-calculator$/, '')];
---
{drawing && <span class="tool-illustration" aria-hidden="true"><svg width="72" height="72" viewBox="0 0 80 80" fill="none" stroke-linecap="round" stroke-linejoin="round"><path class="material" d={drawing[0]} /><path class="measurement" d={drawing[1]} /></svg></span>}
<style>
.tool-illustration{display:flex;align-items:center;justify-content:center;width:72px;height:72px;flex:0 0 72px;background:var(--surface-2);border-radius:8px;color:var(--muted)}
svg{display:block;width:100%;height:100%;stroke-width:1.6}.material{stroke:currentColor;fill:var(--illustration-fill,#dfe3d7);fill-opacity:.45}.measurement{stroke:var(--accent);stroke-width:1.8}
:global([data-theme="dark"]) .tool-illustration{--illustration-fill:#6e856e}
@media(max-width:1050px){.tool-illustration{width:60px;height:60px;flex-basis:60px}}
@media(max-width:700px){.tool-illustration{width:52px;height:52px;flex-basis:52px}}
</style>
