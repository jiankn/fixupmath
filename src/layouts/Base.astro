---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import { SITE, ADSENSE_CLIENT, IS_PREVIEW } from '../site';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL('/', Astro.site).href;
const pageTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const nav = [
  { name: 'All calculators', href: '/#all-calculators' },
  { name: 'Concrete calculator', href: '/concrete-calculator/' },
  { name: 'About', href: '/about/' },
];
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${origin}#organization`,
  name: SITE.name, url: origin, logo: `${origin}images/brand/measured-block.png`, email: SITE.contactEmail,
  ...(SITE.sameAs.length ? { sameAs: SITE.sameAs } : {}),
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>try { const t = localStorage.getItem('fum-theme'); if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark'; } catch {}</script>
  <title>{pageTitle}</title><meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(noindex || IS_PREVIEW) && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon-d.png" type="image/png" sizes="512x512" />
  <link rel="icon" href="/favicon-d-192.png" type="image/png" sizes="192x192" />
  <link rel="icon" href="/favicon-d-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon-d.png" sizes="180x180" />
  <meta name="theme-color" content="#ad3e1c" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:locale" content={SITE.locale} />
  <meta name="twitter:card" content="summary" /><link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <slot name="head" />
  {ADSENSE_CLIENT && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site">
    <div class="wrap bar">
      <Brand />
      <nav class="desktop-nav" aria-label="Main navigation">
        {nav.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.name}</a>)}
      </nav>
      <div class="header-actions">
        <button type="button" class="theme-toggle no-print" aria-label="Toggle theme" title="Toggle theme">
          <svg class="theme-icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <svg class="theme-icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
          </svg>
          <span class="visually-hidden">Toggle theme</span>
        </button>
        <details class="mobile-menu">
          <summary aria-label="Navigation menu"><span>Menu</span><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 5h16M2 10h16M2 15h16" /></svg></summary>
          <nav aria-label="Mobile navigation">{nav.map(link => <a href={link.href}>{link.name}</a>)}<a href="/contact/">Contact</a></nav>
        </details>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site">
    <div class="wrap foot">
      <div class="footer-brand"><Brand /><p>Less guesswork.<br />More getting it done.</p><span class="small muted">Free calculators for home, yard, and building projects.</span></div>
      <div class="footer-links">
        <nav aria-label="Explore"><strong>Plan your project</strong><a href="/#all-calculators">All calculators</a><a href="/concrete-masonry/">Concrete & masonry</a><a href="/landscaping/">Landscaping & yard</a><a href="/flooring-walls/">Flooring & walls</a></nav>
        <nav aria-label="Site information"><strong>FixUpMath</strong><a href="/about/">About our calculators</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy policy</a><a href="/terms/">Terms of use</a></nav>
      </div>
    </div>
    <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {SITE.name}</span><span>Planning estimates. Confirm quantities with your supplier.</span></div>
  </footer>
</body>
</html>
<script>
const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
if (toggle) {
  const updateToggleUI = (isDark: boolean) => {
    const label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
    toggle.setAttribute('aria-label', label);
    toggle.setAttribute('title', label);
    toggle.setAttribute('aria-pressed', String(isDark));
  };

  updateToggleUI(document.documentElement.dataset.theme === 'dark');

  toggle.addEventListener('click', () => {
    const dark = document.documentElement.dataset.theme !== 'dark';
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    try { localStorage.setItem('fum-theme', dark ? 'dark' : 'light'); } catch {}
    updateToggleUI(dark);
  });

  try {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('fum-theme')) {
        document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
        updateToggleUI(e.matches);
      }
    });
  } catch {}
}
</script>
<style>
.header-actions{display:flex;align-items:center;gap:18px;margin-left:auto}
.theme-toggle{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:44px;
  height:44px;
  padding:0;
  background:transparent;
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  color:var(--muted);
  cursor:pointer;
  transition:color .18s ease,background-color .18s ease,border-color .18s ease,transform .15s ease;
  flex-shrink:0;
}
.theme-toggle:hover{
  background:var(--surface-2);
  color:var(--text);
  border-color:var(--accent);
}
.theme-toggle:active{
  transform:scale(.92);
}
.theme-toggle:focus-visible{
  outline:2px solid var(--focus);
  outline-offset:2px;
}
.theme-icon{
  transition:transform .2s ease;
}
.icon-sun{
  display:none;
}
.icon-moon{
  display:block;
}
:global([data-theme="dark"]) .icon-sun{
  display:block;
  color:var(--accent);
}
:global([data-theme="dark"]) .icon-moon{
  display:none;
}
.theme-toggle:hover .theme-icon{
  transform:rotate(12deg);
}
header.site{background:var(--bg);border-bottom:1px solid var(--border)}
.bar{min-height:56px;display:flex;align-items:center;gap:40px;position:relative}
.desktop-nav{position:absolute;inset-block:0;left:50%;transform:translateX(-50%);display:flex;align-items:stretch;gap:28px}
.desktop-nav a{display:flex;align-items:center;font-size:.875rem;font-weight:550;text-decoration:none;color:var(--muted);border-bottom:3px solid transparent;padding-top:3px;white-space:nowrap}
.desktop-nav a:hover,.desktop-nav a[aria-current]{color:var(--text);border-color:var(--accent)}
.mobile-menu{display:none}
main{min-height:65vh}
footer.site{margin-top:80px;padding:48px 0 22px;background:var(--surface);border-top:1px solid var(--border)}
.foot{display:flex;justify-content:space-between;gap:64px}
.footer-brand p{font-size:1.35rem;font-weight:600;line-height:1.4;letter-spacing:-.02em;margin:22px 0 12px}
.footer-links{display:flex;gap:80px}.footer-links nav{display:flex;flex-direction:column;align-items:start;gap:10px;font-size:.875rem}
.footer-links strong{margin-bottom:6px}.footer-links a{color:var(--muted);text-decoration:none}.footer-links a:hover{color:var(--accent)}
.footer-bottom{display:flex;justify-content:space-between;gap:24px;margin-top:42px;padding-top:20px;border-top:1px solid var(--border);color:var(--muted);font-size:.75rem}
@media(max-width:1050px){.footer-links{gap:40px}}
@media(max-width:700px){.foot{flex-direction:column;gap:32px}.footer-links{gap:32px;justify-content:space-between}.footer-bottom{flex-direction:column;gap:8px}.footer-links nav{font-size:.8125rem}footer.site{margin-top:56px;padding-bottom:96px}}
@media(max-width:760px){.bar{min-height:48px;gap:12px;justify-content:space-between}.desktop-nav{display:none}.header-actions{gap:10px}.mobile-menu{display:block}.mobile-menu summary{display:flex;align-items:center;gap:12px;min-height:44px;padding:2px 8px;list-style:none;font-size:.875rem;cursor:pointer}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu nav{position:absolute;top:calc(100% - 1px);left:0;right:0;z-index:30;background:var(--surface);border:1px solid var(--border);padding:12px 18px;display:flex;flex-direction:column}.mobile-menu nav a{padding:12px;color:var(--text);text-decoration:none}}
@media(max-width:380px){.header-actions{gap:4px}.mobile-menu summary{gap:6px;padding-inline:4px}}
</style>
